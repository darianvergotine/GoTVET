<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>GoTVET</ApplicationTitle>
    <Product>GoTVET</Product>
    <Company>GoTVET</Company>
    <Description>Free TVET past papers for South African students</Description>
    <Version>1.0.0</Version>
    <RootNamespace>GoTVET</RootNamespace>
    <AssemblyName>GoTVET</AssemblyName>
    <ApplicationIcon>GoTVET-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="GoTVET-icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
