<Application x:Class="GoTVET.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <SolidColorBrush x:Key="BrandGreen" Color="#0F6B4C"/>
    <SolidColorBrush x:Key="BrandGreenDark" Color="#0A4D38"/>
    <SolidColorBrush x:Key="BrandGold" Color="#D4A017"/>
    <SolidColorBrush x:Key="BrandOnPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrandOnGold" Color="#0A4D38"/>
    <SolidColorBrush x:Key="HeaderForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderMuted" Color="#D9F3E8"/>
    <SolidColorBrush x:Key="Ink" Color="#12263A"/>
    <SolidColorBrush x:Key="Muted" Color="#5B6B7A"/>
    <SolidColorBrush x:Key="Paper" Color="#F6F3EC"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#E4DDD0"/>

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="{StaticResource Paper}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource BrandGreen}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimary}"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.55"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource BrandGreenDark}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrandGreenDark}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,10"/>
    </Style>
  </Application.Resources>
</Application>
